{
  "name": "@doxynix/siem-server",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "with-doppler": "bun scripts/doppler.ts",
    "dev": "bun with-doppler -- bun run --watch src/index.ts",
    "type-check": "tsc --noEmit",
    "db:generate": "bun with-doppler drizzle-kit generate",
    "db:push": "bun with-doppler drizzle-kit push",
    "db:studio": "bun with-doppler drizzle-kit studio",
    "db:migrate": "bun with-doppler bun scripts/migrate.ts",
    "db:seed:rules": "bun with-doppler bun scripts/seed-rules.ts"
  },
  "dependencies": {
    "@axiomhq/js": "1.8.0",
    "@better-auth/drizzle-adapter": "1.6.25",
    "@doxynix/siem-shared": "workspace:*",
    "@hono/zod-validator": "0.9.0",
    "@t3-oss/env-core": "0.13.11",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "es-toolkit": "1.50.0",
    "hono": "4.12.33",
    "ioredis": "6.0.0",
    "postgres": "3.4.9",
    "re2": "1.26.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
