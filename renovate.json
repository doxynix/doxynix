{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "extends": ["config:best-practices", "monorepo:react", "monorepo:nextjs", "group:monorepos"],
  "gitAuthor": "doxynix-deps-bot <273657142+doxynix-deps-bot[bot]@users.noreply.github.com>",
  "ignoreDeps": ["zod-prisma-types"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    { "addLabels": ["major-update"], "matchUpdateTypes": ["major"] },
    { "addLabels": ["minor-update"], "matchUpdateTypes": ["minor"] },
    { "addLabels": ["patch-update"], "matchUpdateTypes": ["patch"] },
    {
      "description": "Group AI and LLM tools",
      "groupName": "AI ecosystem",
      "matchPackageNames": [
        "/^@ai-sdk//",
        "/^ai$/",
        "/^@modelcontextprotocol//",
        "/^mcp-handler$/",
        "/^langsmith$/",
        "/^@lenml//"
      ]
    },
    {
      "description": "Group Better-Auth packages",
      "groupName": "Better Auth",
      "matchPackageNames": [
        "/^better-auth$/",
        "/^@better-auth//"
      ]
    },
    {
      "description": "Group Database ORMs and Generators",
      "groupName": "Database & ORMs",
      "matchPackageNames": [
        "/^@prisma//",
        "/^prisma/",
        "/^@zenstackhq//",
        "/^zenstack$/",
        "/^drizzle-orm$/",
        "/^drizzle-kit$/",
        "/^drizzle-zod$/"
      ]
    },
    {
      "description": "Group TanStack packages",
      "groupName": "TanStack ecosystem",
      "matchPackageNames": [
        "/^@tanstack//"
      ]
    },
    {
      "description": "Group CodeMirror and editor extensions",
      "groupName": "CodeMirror & Editor",
      "matchPackageNames": [
        "/^@codemirror//",
        "/^@uiw/codemirror/",
        "/^@uiw/react-codemirror/",
        "/^@lezer//",
        "/^@replit/codemirror-/",
        "/^react-codemirror-merge$/"
      ]
    },

    {
      "description": "Group UI, styling and chart libraries",
      "groupName": "UI and styling",
      "matchPackageNames": [
        "/^@radix-ui//",
        "/^@react-aria//",
        "/^@react-stately//",
        "/^@remixicon//",
        "/^lucide-react$/",
        "/^recharts$/",
        "/^motion$/",
        "/^cmdk$/",
        "/^sonner$/",
        "/^@xyflow//",
        "/^tailwind/",
        "/^@tailwindcss//",
        "/^clsx$/",
        "/^class-variance-authority$/"
      ]
    },

    {
      "description": "Group Markdown, AST parsers and Syntax Highlighters",
      "groupName": "Markdown & Syntax Highlighting",
      "matchPackageNames": [
        "/^@shikijs//",
        "/^shiki$/",
        "/^rehype-/",
        "/^remark-/",
        "/^unified$/",
        "/^unist-/",
        "/^mermaid$/",
        "/^@mermaid-js//"
      ]
    },
    {
      "description": "Group Linters, Formatters and Dev Tooling",
      "groupName": "Linters & Dev Tools",
      "matchPackageNames": [
        "/^@biomejs//",
        "/^oxlint/",
        "/^cspell/",
        "/^@cspell//",
        "/^secretlint/",
        "/^@secretlint//",
        "/^knip/",
        "/^@stryker-mutator//",
        "/^typedoc/",
        "/^@boneskull/typedoc-/",
        "/^@to-skills/typedoc/",
        "/^lefthook$/",
        "/^jscpd$/",
        "/^@jscpd//"
      ]
    },
    {
      "description": "Group testing frameworks and runners",
      "groupName": "Testing frameworks",
      "matchPackageNames": [
        "/^@playwright//",
        "/^vitest$/",
        "/^@vitest//",
        "/^fast-check$/",
        "/^@faker-js/faker$/"
      ]
    },
    {
      "description": "Group Backend Services and SDKs",
      "groupName": "Backend SDKs & Services",
      "matchPackageNames": [
        "/^hono$/",
        "/^@hono//",
        "/^@trpc//",
        "/^@trigger.dev//",
        "/^@upstash//",
        "/^@sentry//",
        "/^posthog-/",
        "/^@axiomhq//",
        "/^resend$/",
        "/^svix$/",
        "/^ably$/",
        "/^@t3-oss//"
      ]
    },
    {
      "description": "Group GitHub API and Octokit libraries",
      "groupName": "Octokit & GitHub tools",
      "matchPackageNames": [
        "/^@octokit//",
        "/^octokit-plugin-/"
      ]
    },
    {
      "description": "Group all TypeScript definitions",
      "groupName": "TypeScript definitions (@types)",
      "matchPackageNames": ["@types/**"]
    },
    {
      "description": "Group GitHub Actions",
      "groupName": "GitHub Actions",
      "groupSlug": "all-actions",
      "matchManagers": ["github-actions"]
    },
    {
      "description": "Group all other non-major dependencies",
      "groupName": "All other non-major dependencies",
      "groupSlug": "all-other-minor-patch",
      "matchManagers": ["bun", "npm"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "allowedVersions": "<1.0.0",
      "description": "Restrict cookie to <1.0.0 for auth compatibility",
      "matchPackageNames": ["cookie"]
    },
    {
      "description": "Freeze Tree-sitter packages due to custom WASM patch",
      "enabled": false,
      "matchPackageNames": ["web-tree-sitter", "tree-sitter-wasms"]
    }
  ],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 5,
  "rangeStrategy": "pin",
  "rebaseWhen": "conflicted",
  "semanticCommitScope": "deps",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "separateMajorMinor": true,
  "timezone": "Europe/Moscow",
  "vulnerabilityAlerts": {
    "addLabels": ["security"],
    "enabled": true
  }
}
