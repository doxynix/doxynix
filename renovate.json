{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": false,
  "dependencyDashboard": true,
  "extends": ["config:best-practices", "monorepo:react", "monorepo:nextjs", "group:monorepos"],
  "gitAuthor": "doxynix-deps-bot <273657142+doxynix-deps-bot[bot]@users.noreply.github.com>",
  "ignoreDeps": ["zod-prisma-types"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "addLabels": ["major-update"],
      "matchUpdateTypes": ["major"]
    },
    {
      "addLabels": ["minor-update"],
      "matchUpdateTypes": ["minor"]
    },
    {
      "addLabels": ["patch-update"],
      "matchUpdateTypes": ["patch"]
    },
    {
      "description": "Group all non-major npm updates into a single PR to reduce noise across the monorepo",
      "groupName": "All non-major dependencies",
      "groupSlug": "all-minor-patch",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Group all GitHub Actions updates together",
      "groupName": "GitHub Actions updates",
      "groupSlug": "all-actions",
      "matchManagers": ["github-actions"]
    },
    {
      "description": "Group all @types updates together",
      "groupName": "TypeScript definitions (@types)",
      "matchPackageNames": ["@types/**"]
    },
    {
      "allowedVersions": "<1.0.0",
      "description": "Restrict cookie package to <1.0.0 to maintain compatibility with auth and socket modules",
      "matchPackageNames": ["cookie"]
    },
    {
      "description": "Freeze Tree-sitter related packages due to fragile WASM grammar compatibility",
      "enabled": false,
      "matchPackageNames": ["web-tree-sitter", "tree-sitter-wasms"]
    }
  ],
  "pinDigests": true,
  "prConcurrentLimit": 10,
  "prHourlyLimit": 5,
  "rangeStrategy": "pin",
  "rebaseWhen": "behind-base-branch",
  "semanticCommitScope": "deps",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "separateMajorMinor": true,
  "timezone": "Europe/Moscow",
  "vulnerabilityAlerts": {
    "addLabels": ["security"],
    "enabled": true
  }
}
