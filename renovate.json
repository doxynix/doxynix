{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "gitAuthor": "doxynix-deps-bot <273657142+doxynix-deps-bot[bot]@users.noreply.github.com>",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "timezone": "Europe/Moscow",
  "pinDigests": true,
  "rangeStrategy": "pin",
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": [],
  "labels": ["dependencies"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["security"]
  },
  "separateMajorMinor": true,
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "automerge": false,
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "addLabels": ["minor-update"]
    },
    {
      "matchUpdateTypes": ["patch"],
      "addLabels": ["patch-update"]
    },
    {
      "description": "Group all minor and patch npm updates into a single PR to reduce noise",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Group ALL GitHub Actions updates together",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions updates",
      "groupSlug": "all-actions"
    },
    {
      "description": "Group all @types updates separately",
      "matchPackageNames": ["@types/**"],
      "groupName": "all @types"
    }
  ]
}
