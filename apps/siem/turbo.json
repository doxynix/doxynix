{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".turbo/**"],
      "env": ["NODE_ENV", "VITE_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["NODE_ENV", "PORT", "VITE_*"]
    },
    "lint": {
      "env": ["NODE_ENV"]
    },
    "type-check": {
      "outputs": [".tsbuildinfo"],
      "env": ["NODE_ENV"]
    },
    "test": {
      "outputs": ["coverage/**", "test-results/**"],
      "env": ["NODE_ENV", "CI"]
    }
  },
  "globalDependencies": [".gitignore", "biome.json"],
  "globalEnv": ["NODE_ENV", "CI", "TURBO_TOKEN", "TURBO_TEAM", "TURBO_REMOTE_ONLY"]
}
