{
  "name": "@doxynix/siem-server",
  "version": "0.2.0",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "default": "./dist/src/client.js"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "db:drop-migration": "bun with-doppler bun drizzle-kit drop",
    "db:generate": "bun with-doppler drizzle-kit generate",
    "db:migrate": "bun with-doppler bun scripts/migrate.ts",
    "db:push": "bun with-doppler drizzle-kit push",
    "db:seed:rules": "bun with-doppler bun scripts/seed-rules.ts",
    "db:studio": "bun with-doppler drizzle-kit studio",
    "dev": "bun with-doppler -- bun run --watch src/index.ts",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "seed:admin": "bun with-doppler bun scripts/seed-admin.ts",
    "type-check": "tsc -b",
    "validate": "biome check . && oxlint",
    "with-doppler": "bun scripts/doppler.ts"
  },
  "dependencies": {
    "@axiomhq/js": "1.8.0",
    "@better-auth/drizzle-adapter": "catalog:",
    "@doxynix/shared": "workspace:*",
    "@hono/zod-validator": "0.9.0",
    "@t3-oss/env-core": "0.13.11",
    "better-auth": "catalog:",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "es-toolkit": "catalog:",
    "hono": "catalog:",
    "ioredis": "catalog:",
    "postgres": "3.4.9",
    "temporal-polyfill": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@doxynix/config": "workspace:*",
    "drizzle-kit": "0.31.10"
  }
}
