{
  "dependencies": {
    "@axiomhq/js": "1.8.0",
    "@better-auth/drizzle-adapter": "1.6.30",
    "@doxynix/shared": "workspace:*",
    "@hono/zod-validator": "0.9.0",
    "@js-temporal/polyfill": "0.5.1",
    "@t3-oss/env-core": "0.13.11",
    "better-auth": "1.6.30",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "es-toolkit": "1.51.0",
    "eventemitter3": "5.0.4",
    "hono": "4.13.4",
    "ioredis": "6.0.0",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@doxynix/config": "workspace:*",
    "drizzle-kit": "0.31.10"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./client": {
      "default": "./src/client.ts",
      "types": "./src/client.ts"
    }
  },
  "main": "src/index.ts",
  "name": "@doxynix/siem-server",
  "scripts": {
    "build": "tsc",
    "db:drop-migration": "bun with-doppler bun drizzle-kit drop",
    "db:generate": "bun with-doppler drizzle-kit generate",
    "db:migrate": "bun with-doppler bun scripts/migrate.ts",
    "db:push": "bun with-doppler drizzle-kit push",
    "db:seed:rules": "bun with-doppler bun scripts/seed-rules.ts",
    "db:studio": "bun with-doppler drizzle-kit studio",
    "dev": "bun with-doppler -- bun run --watch src/index.ts",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "seed:admin": "bun with-doppler bun scripts/seed-admin.ts",
    "type-check": "tsc -b",
    "validate": "biome check . && oxlint",
    "with-doppler": "bun scripts/doppler.ts"
  },
  "types": "src/index.ts",
  "version": "0.2.0"
}
