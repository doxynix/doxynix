{
  "$schema": "https://ui.shadcn.com/schema.json",
  "aliases": {
    "components": "@/shared",
    "hooks": "@/shared/hooks",
    "lib": "@/shared/lib",
    "ui": "@/shared/ui/core",
    "utils": "@/shared/lib/utils"
  },
  "iconLibrary": "lucide",
  "registries": {
    "@aceternity": "https://ui.aceternity.com/registry/{name}.json",
    "@magicui": "https://magicui.design/r/{name}"
  },
  "rsc": true,
  "style": "new-york",
  "tailwind": {
    "baseColor": "slate",
    "config": "tailwind.config.ts",
    "css": "src/app/globals.css",
    "cssVariables": true,
    "prefix": ""
  },
  "tsx": true
}
