  "name": "@doxynix/web",
  "private": true,
  "scripts": {
    "analyze": "bun with-doppler \"cross-env ANALYZE=true next build --webpack\"",
    "analyze:exp": "bun with-doppler \"next experimental-analyze\"",
    "arch:check": "depcruise src --config .dependency-cruiser.js --output-type err",
    "arch:graph": "depcruise src --collapse 2 --config .dependency-cruiser.js --output-type dot | dot -T svg > arch/architecture.svg",
    "build": "bun ../../scripts/clean-symlinks.ts && bun with-doppler \"cross-env NODE_OPTIONS=\\\"--max-old-space-size=6144\\\" next build --webpack\"",
    "build:turbopack": "bun ../../scripts/clean-symlinks.ts && bun with-doppler \"cross-env NODE_OPTIONS=\\\"--max-old-space-size=4096\\\" next build\"",
    "db:generate": "bun with-doppler bun scripts/zenstack-gen.mjs && bun with-doppler bun prisma generate --sql",
    "db:migrate": "bun with-doppler \"bun db:generate && prisma migrate dev\"",
    "db:migrate-prod": "doppler run -c prd -- sh -c \"bun db:generate && prisma migrate deploy\"",
    "db:push": "bun with-doppler \"prisma db push\"",
    "db:reset": "bun with-doppler \"prisma migrate reset\"",
    "db:seed": "bun with-doppler \"bun db:generate && prisma db seed\"",
    "db:studio": "bun with-doppler \"prisma studio\"",
    "dev": "bun with-doppler \"cross-env NODE_OPTIONS=\\\"--max-old-space-size=4096\\\" next dev\"",
    "dev:analyze": "bun with-doppler \"cross-env ANALYZE=true next dev\"",
    "dev:fast": "bun with-doppler \"cross-env NODE_OPTIONS=\\\"--max-old-space-size=2048\\\" next dev\"",
    "dev:trace": "bun with-doppler \"cross-env NEXT_TURBOPACK_TRACING=1 NODE_OPTIONS=\\\"--max-old-space-size=2048\\\" next dev\"",
    "doc:gen": "typedoc",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "gen:client": "bun with-doppler \"openapi --input http://localhost:3000/api/openapi --output ./src/shared/api-contracts/client --client axios\"",
    "gen:credits": "bun scripts/thanks.mjs",
    "lhci": "lhci autorun",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "bun with-doppler \"next start\"",
    "test": "bun with-doppler \"cross-env TZ=UTC vitest run --config vitest.config.ts --no-file-parallelism\"",
    "test:coverage": "bun with-doppler \"cross-env TZ=UTC vitest run --coverage --config vitest.config.ts --no-file-parallelism\"",
    "test:e2e": "bun with-doppler \"playwright test\"",
    "test:int": "bun with-doppler \"cross-env TZ=UTC vitest run src/tests/integration --config vitest.config.ts --no-file-parallelism\"",
    "test:stryker": "bun with-doppler \"stryker run vitest.stryker.config.ts\"",
    "test:unit": "bun with-doppler \"cross-env TZ=UTC vitest run src/tests/unit --config vitest.config.ts\"",
    "type-check": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" tsc -b",
    "type-check:coverage": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" type-coverage --detail",
    "validate": "biome check . && oxlint",
    "with-doppler": "bun scripts/doppler.mjs"
  },
  "version": "3.1.0"
}
