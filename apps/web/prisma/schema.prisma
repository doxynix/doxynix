model Notification {
  /// @zod.custom.omit(["model"])
  id        String     @id() @default(dbgenerated("uuidv7()")) @db.Uuid()
  /// @zod.string.trim().min(1, { message: "The title cannot be empty" }).max(300, { message: "The title cannot exceed 300 characters" })
  title     String
  /// @zod.string.trim().min(1, { message: "The text of the notification is mandatory" }).max(5000, { message: "The text of the notification cannot exceed 5000 characters" })
  body      String
  type      NotifyType @default(INFO)
  isRead    Boolean    @default(false) @map("is_read")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt() @map("updated_at")
  /// @zod.custom.omit(["model"])
  userId    String     @map("user_id") @db.Uuid()
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// @zod.custom.omit(["model"])
  repoId    String?    @map("repo_id") @db.Uuid()
  repo      Repo?      @relation(fields: [repoId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, isRead, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, type, createdAt(sort: Desc), id(sort: Desc)])
  @@index([repoId])
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "notifications_created_at_id_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "notifications_title_trgm_idx")
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin, map: "notifications_body_trgm_idx")
  @@map("notifications")
}

