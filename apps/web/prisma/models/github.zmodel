import "./auth"
import "./workspace"
import "./review"
import "./core"

model Repo {
  /// @zod.custom.omit(["model"])
  id               String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  githubId         Int                        @map("github_id")
  owner            String                     @db.Citext @length(min: 1, max: 39, message: "Repository owner login cannot exceed 39 characters")
  /// @zod.string.min(1).max(255)
  name             String                     @db.Citext @length(min: 1, max: 255)
  /// @zod.string.max(1000)
  description      String?                    @db.Text @length(max: 1000)
  /// @zod.string.url({ message: "Invalid repository URL" })
  url              String                     @url
  language         String?
  license          String?
  topics           String[]
  /// @zod.number.int().min(0)
  stars            Int                        @default(0) @map("stargazers_count") @gte(0)
  /// @zod.number.int().min(0)
  forks            Int                        @default(0) @map("forks_count") @gte(0)
  defaultBranch    String                     @default("main") @map("default_branch")
  /// @zod.string.url()
  ownerAvatarUrl   String?                    @map("owner_avatar_url") @url
  /// @zod.number.int().min(0)
  openIssues       Int                        @default(0) @map("open_issues_count") @gte(0)
  /// @zod.number.int().min(0)
  size             Int                        @default(0) @gte(0)
  visibility       Visibility                 @default(PRIVATE)

  pushedAt         DateTime?                  @map("pushed_at")
  createdAt        DateTime                   @default(now()) @map("created_at")
  githubCreatedAt  DateTime?                  @map("github_created_at")
  updatedAt        DateTime                   @default(now()) @updatedAt @map("updated_at")

  /// @zod.custom.omit(["model"])
  workspaceId      String                     @map("workspace_id") @db.Uuid
  workspace        Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// @zod.custom.omit(["model"])
  createdByUserId  String                     @map("created_by_user_id") @db.Uuid @omit
  createdBy        User                       @relation("RepoCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  analyses         Analysis[]
  documents        Document[]
  notifications    Notification[]
  pullRequests     PullRequestAnalysis[]      @relation("RepoPullRequests")
  generatedFixes   GeneratedFix[]             @relation("RepoGeneratedFixes")
  chatSessions      ChatSession[]

  prAnalysisConfig PullRequestAnalysisConfig?

  @@deny('all', auth() == null)
  @@allow('read,delete', workspace.members?[userId == auth().id] || auth().role == 'ADMIN')
  @@allow('create', createdByUserId == auth().id && workspace.members?[userId == auth().id])
  @@allow(
    'update',
    (workspace.members?[userId == auth().id] && future().workspaceId == workspaceId && future().createdByUserId == createdByUserId) ||
    auth().role == 'ADMIN'
  )

  @@unique([owner, name, workspaceId])
  @@unique([githubId, workspaceId])
  @@index([workspaceId, owner])
  @@index([workspaceId, name])
  @@index([workspaceId, visibility, createdAt(sort: Desc)])
  @@index([workspaceId, updatedAt(sort: Desc), id(sort: Desc)], map: "repos_workspace_id_updated_at_id_idx")
  @@index([createdByUserId])
  @@index([updatedAt(sort: Desc), id(sort: Desc)], map: "repos_updated_at_id_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "repos_name_trgm_idx")
  @@index([owner(ops: raw("gin_trgm_ops"))], type: Gin, map: "repos_owner_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "repos_description_trgm_idx")

  @@map("repos")
}

model GithubInstallation {
  id                  BigInt                 @id
  appId               Int                    @map("app_id")
  targetId            BigInt                 @map("target_id")
  targetType          InstallationTargetType @map("target_type")
  accountLogin        String                 @map("account_login") @db.Citext @length(min: 1, max: 39, message: "GitHub login cannot exceed 39 characters")
  accountAvatar       String?                @map("account_avatar")
  repositorySelection RepositorySelection    @map("repository_selection")

  isSuspended         Boolean                @default(false) @map("is_suspended")
  htmlUrl             String?                @map("html_url")

  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @default(now()) @updatedAt @map("updated_at")

  workspaceId         String                 @map("workspace_id") @db.Uuid
  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId              String?                @map("user_id") @db.Uuid @omit
  user                User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@deny('all', auth() == null)
  @@allow('read', workspace.members?[userId == auth().id] || auth().role == 'ADMIN')
  @@allow('delete', auth().role == 'ADMIN')
  @@allow('create', auth().role == 'ADMIN')
  @@allow(
    'update',
    workspace.members?[userId == auth().id] || auth().role == 'ADMIN'
  )

  @@index([workspaceId, isSuspended, createdAt(sort: Asc)])
  @@index([workspaceId, isSuspended, accountLogin])
  @@index([userId])

  @@map("github_installations")
}

enum Visibility {
  PUBLIC
  PRIVATE
}
enum InstallationTargetType {
  USER
  ORGANIZATION
}
enum RepositorySelection {
  ALL
  SELECTED
}
