import "./auth"
import "./github"

model Notification {
  /// @zod.custom.omit(["model"])
  id        String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// @zod.string.trim().min(1, { message: "The title cannot be empty" }).max(300, { message: "The title cannot exceed 300 characters" })
  title     String
  /// @zod.string.trim().min(1, { message: "The text of the notification is mandatory" }).max(5000, { message: "The text of the notification cannot exceed 5000 characters" })
  body      String
  type      NotifyType @default(INFO)
  isRead    Boolean    @default(false) @map("is_read")

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")

  /// @zod.custom.omit(["model"])
  userId    String     @map("user_id") @db.Uuid @omit
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// @zod.custom.omit(["model"])
  repoId    String?    @map("repo_id") @db.Uuid @omit
  repo      Repo?      @relation(fields: [repoId], references: [id], onDelete: SetNull)

  @@deny('all', auth() == null)
  @@allow(
    'all',
    (auth() == user && (repoId == null || repo.workspace.members?[userId == auth().id])) ||
    auth().role == 'ADMIN'
  )
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, isRead, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, type, createdAt(sort: Desc), id(sort: Desc)])
  @@index([repoId])
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "notifications_created_at_id_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "notifications_title_trgm_idx")
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin, map: "notifications_body_trgm_idx")

  @@map("notifications")
}

model UserAppearance {
  /// @zod.custom.omit(["model"])
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// @zod.custom.omit(["model"])
  userId      String   @unique @map("user_id") @db.Uuid @omit
  preferences Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@allow('all', auth() == user)
  @@map("user_appearances")
}



model WebhookDelivery {
  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider   String
  deliveryId String        @map("delivery_id")
  event      String?
  status     WebhookStatus @default(PROCESSING)
  error      String?       @db.Text

  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at")

  @@allow('create', true)
  @@allow('read', auth().role == 'ADMIN')
  @@allow('update,delete', false)

  @@unique([provider, deliveryId])
  @@index([createdAt(sort: Desc)])
  @@map("webhook_deliveries")
}

model AuditLog {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requestId String?  @map("request_id")
  model     AuditModel
  operation AuditOperation
  payload   Json
  /// @zod.custom.omit(["model"])
  userId    String?  @map("user_id") @db.Uuid @omit
  ip        String?  @db.Inet
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@allow('create', true)
  @@allow('read', auth().role == 'ADMIN' || (userId != null && auth().id == userId))
  @@allow('update,delete', false)

  @@index([requestId])
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "audit_logs_created_at_id_idx")
  @@index([userId, operation])
  @@index([operation, createdAt(sort: Desc)])

  @@map("audit_logs")
}

enum AuditOperation {
  CREATE                 @map("create")
  CREATE_MANY            @map("createMany")
  CREATE_MANY_AND_RETURN @map("createManyAndReturn")
  UPDATE                 @map("update")
  UPDATE_MANY            @map("updateMany")
  UPDATE_MANY_AND_RETURN @map("updateManyAndReturn")
  UPSERT                 @map("upsert")
  DELETE                 @map("delete")
  DELETE_MANY            @map("deleteMany")
}

enum AuditModel {
  Account
  Analysis
  ApiKey
  BannedEmail
  ChatMessage
  ChatSession
  Document
  GeneratedFix
  GithubInstallation
  Notification
  Passkey
  PullRequestAnalysis
  PullRequestAnalysisConfig
  PullRequestComment
  Repo
  Session
  TwoFactor
  User
  Verification
  WebhookDelivery
}

model ChatSession {
  id        String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  repoId    String?       @map("repo_id") @db.Uuid
  title     String        @default("New Chat")

  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo      Repo?         @relation(fields: [repoId], references: [id], onDelete: Cascade)

  messages  ChatMessage[]

  @@index([repoId])
  @@index([userId, updatedAt(sort: Desc)])

  @@deny('all', auth() == null)
  @@allow(
    'all',
    (userId == auth().id && (repoId == null || repo.workspace.members?[userId == auth().id])) ||
    auth().role == 'ADMIN'
  )
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      ChatRole

  /// @encrypted
  parts     String

  createdAt DateTime    @default(now()) @map("created_at")

  @@deny('all', auth() == null)
  @@allow(
    'all',
    (session.userId == auth().id &&
      (session.repoId == null || session.repo.workspace.members?[userId == auth().id])) ||
    auth().role == 'ADMIN'
  )

  @@index([sessionId, createdAt(sort: Asc)])
  @@map("chat_messages")
}




enum NotifyType {
  ERROR
  WARNING
  INFO
  SUCCESS
}

enum WebhookStatus {
  PROCESSING
  SUCCESS
  FAILED
}


enum ChatRole {
  user
  assistant
  system
  data
}
