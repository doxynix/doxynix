{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@pkg": ["./package.json"],
      "@public/*": ["./public/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "exclude": [
    "node_modules",
    ".vscode",
    ".github",
    ".changeset",
    ".husky",
    ".next",
    ".trigger",
    "coverage",
    "public",
    "report",
    "./scripts"
  ],
  "extends": "@doxynix/config/nextjs.json",
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "trigger.config.ts",
    "src/global.d.ts",
    "messages/*.json",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ]
}
