{
  "$schema": "https://typedoc.org/schema.json",
  "cleanOutputDir": true,
  "entryFileName": "INDEX_FOR_AI.md",
  "entryPointStrategy": "expand",
  "entryPoints": ["src"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "**/shared/api-contracts/**", "**/node_modules/**"],
  "excludeInternal": true,
  "excludePrivate": true,
  "hideBreadcrumbs": true,
  "hideGenerator": true,
  "hidePageTitle": false,
  "includeVersion": true,
  "llmsTxt": true,
  "llmsTxtOutDir": "/docs/llms",
  "name": "Doxynix",
  "out": "public/docs",
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-plugin-zod",
    "typedoc-plugin-extras",
    "typedoc-plugin-rename-defaults",
    "@boneskull/typedoc-plugin-mermaid",
    "@to-skills/typedoc"
  ],
  "publicPath": "/docs/",
  "skillsIncludeExamples": true,
  "skillsIncludeSignatures": true,
  "skillsMaxTokens": 8000,
  "skillsOutDir": "/docs/skills",
  "skipErrorChecking": true,
  "useCodeBlocks": true
}
