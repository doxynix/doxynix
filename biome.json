{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "noDuplicateClasses": "on",
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":BUN:", ":NODE:"],
              ":BLANK_LINE:",
              ["react", "react/**", "react-dom", "react-dom/**"],
              ["next", "next/**"],
              ["hono", "hono/**"],
              ":PACKAGE:",
              ":BLANK_LINE:",
              ["@doxynix/**", "@doxynix/*"],
              ":BLANK_LINE:",
              ["@/shared/**", "@/i18n/**", "@/core/**", "@/utils/**"],
              ":BLANK_LINE:",
              ["@/entities/**", "@/modules/**"],
              ":BLANK_LINE:",
              "@/features/**",
              ":BLANK_LINE:",
              ["@/widgets/**", "@/ui/**"],
              ":BLANK_LINE:",
              [
                "@/app/**",
                "@/routes/**",
                "@/commands/**",
                "@/server/**",
                "@/trigger/**",
                "@/tests/**"
              ],
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:",
              ":BLANK_LINE:",
              ["*.css", "*.scss", "*.module.css", "./*.css", "@/*.css"]
            ]
          }
        },
        "useSortedAttributes": "on",
        "useSortedEnumMembers": "on",
        "useSortedKeys": "on",
        "useSortedPackageJson": "on",
        "useSortedProperties": "on"
      }
    },
    "enabled": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/.next",
      "!!**/out",
      "!!**/build",
      "!!**/dist",
      "!!**/.turbo",
      "!!**/.vercel",
      "!!**/drizzle",
      "!!**/coverage",
      "!!**/report",
      "!!**/playwright-report",
      "!!**/.trigger",
      "!!**/public",
      "!!**/.stryker-tmp",
      "!!**/messages/en.d.json.ts",
      "!!**/routeTree.gen.ts",
      "!!**/next-env.d.ts",
      "!!**/prisma/generated",
      "!!**/prisma/json-schema",
      "!!**/bun.lock"
    ]
  },
  "formatter": {
    "attributePosition": "multiline",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "useEditorconfig": true
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "bracketSpacing": true,
      "enabled": true,
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "style": {
        "useImportType": {
          "level": "error",
          "options": {
            "style": "inlineType"
          }
        }
      }
    }
  },
  "vcs": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": ["**/package.json"],
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      }
    }
  ]
}
