{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":BUN:", ":NODE:"],
              ":BLANK_LINE:",
              ["react", "react/**", "react-dom", "react-dom/**"],
              ["next", "next/**"],
              ["hono", "hono/**"],
              ":PACKAGE:",
              ":BLANK_LINE:",
              ["@doxynix/**", "@doxynix/*"],
              ":BLANK_LINE:",
              ["@/shared/**", "@/i18n/**", "@/core/**", "@/utils/**"],
              ":BLANK_LINE:",
              ["@/entities/**", "@/modules/**"],
              ":BLANK_LINE:",
              "@/features/**",
              ":BLANK_LINE:",
              ["@/widgets/**", "@/ui/**"],
              ":BLANK_LINE:",
              [
                "@/app/**",
                "@/routes/**",
                "@/commands/**",
                "@/server/**",
                "@/trigger/**",
                "@/shared/api-contracts/**",
                "@/tests/**"
              ],
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:",
              ":BLANK_LINE:",
              ["*.css", "*.scss", "*.module.css", "./*.css", "@/*.css"]
            ]
          }
        },
        "useSortedAttributes": "on",
        "useSortedKeys": "on"
      }
    },
    "enabled": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/.next",
      "!!**/out",
      "!!**/build",
      "!!**/dist",
      "!!**/.turbo",
      "!!**/.vercel",
      "!!**/drizzle",
      "!!**/coverage",
      "!!**/report",
      "!!**/playwright-report",
      "!!**/.trigger",
      "!!**/public",
      "!!**/.stryker-tmp",
      "!!**/src/shared/api-contracts",
      "!!**/messages/en.d.json.ts",
      "!!**/routeTree.gen.ts",
      "!!**/next-env.d.ts",
      "!!**/prisma/generated",
      "!!**/prisma/json-schema",
      "!!**/bun.lock"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 100,
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": false
  },
  "vcs": {
    "enabled": false
  }
}
