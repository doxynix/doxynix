{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".gitignore",
    "packages/config/biome.json",
    "apps/web/eslint.config.mjs",
    "**/.env.*local"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "TURBO_TOKEN",
    "TURBO_TEAM",
    "TURBO_REMOTE_ONLY"
  ],
  "tasks": {
    "db:generate": {
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "REDIS_URL",
        "AXIOM_TOKEN",
        "AXIOM_DATASET"
      ],
      "inputs": [
        "prisma/**/*.schema",
        "prisma/**/*.zmodel",
        "schema.zmodel",
        "src/db/schema.ts",
        "drizzle.config.ts"
      ],
      "outputs": [
        "node_modules/.prisma/**",
        "node_modules/@prisma/client/**",
        "src/shared/api-contracts/client/**"
      ]
    },
    "db:push": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "REDIS_URL",
        "AXIOM_TOKEN",
        "AXIOM_DATASET"
      ]
    },
    "db:studio": {
      "cache": false,
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "REDIS_URL",
        "AXIOM_TOKEN",
        "AXIOM_DATASET"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "outputs": [
        ".next/**",
        "dist/**",
        "build/**",
        ".output/**"
      ],
      "env": [
        "NODE_ENV",
        "VITE_*",
        "NEXT_PUBLIC_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "PORT",
        "VITE_*",
        "NEXT_PUBLIC_*"
      ]
    },
    "lint": {
      "env": [
        "NODE_ENV"
      ]
    },
    "lint:fix": {
      "env": [
        "NODE_ENV"
      ]
    },
    "format": {
      "env": [
        "NODE_ENV"
      ]
    },
    "type-check": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "env": [
        "NODE_ENV",
        "PRISMA_GENERATE_SKIP_QUERIES"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**",
        "test-results/**"
      ],
      "env": [
        "NODE_ENV",
        "CI"
      ]
    }
  }
}