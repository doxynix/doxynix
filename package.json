{
  "name": "doxynix",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=!@doxynix/cli",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "type-check": "turbo type-check",
    "validate": "turbo validate && bun scripts/arch-check.ts",
    "test": "turbo test",
    "test:stryker": "turbo test:stryker",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:migrate": "turbo db:migrate",
    "db:studio": "turbo db:studio",
    "secretlint": "secretlint '**/*'",
    "spellcheck": "cspell \"**/*\" --no-progress --show-suggestions",
    "dup": "jscpd",
    "knip": "SKIP_ENV_VALIDATION=development CI=true knip-bun --no-exit-code",
    "nuke": "rm -rf node_modules/ apps/**/node_modules/ packages/**/node_modules bun.lock .turbo/ .next/ && bun pm cache rm && bun install --force",
    "clean:symlinks": "bun scripts/clean-symlinks.ts",
    "postinstall": "bun scripts/clean-symlinks.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@types/node": "26.1.2",
    "cspell": "10.1.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jscpd": "4.3.0",
    "knip": "6.32.3",
    "lefthook": "2.1.10",
    "secretlint": "13.0.5",
    "@cspell/dict-de-de": "4.1.2",
    "@cspell/dict-en-gb": "5.0.31",
    "@cspell/dict-en_us": "4.4.37",
    "@cspell/dict-es-es": "3.0.8",
    "@cspell/dict-fr-fr": "2.3.2",
    "@cspell/dict-pt-br": "2.4.2",
    "@cspell/dict-pt-pt": "3.0.6",
    "@cspell/dict-ru_ru": "2.3.2",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@codemirror/view": "6.43.9",
    "@codemirror/state": "6.7.1",
    "@hono/node-server": "2.1.1",
    "cookie": "0.7.2",
    "cross-spawn": "7.0.6",
    "dompurify": "3.4.14",
    "effect": "3.22.1",
    "esbuild": "0.25.12",
    "h3": "1.15.11",
    "hono": "4.13.5",
    "lodash-es": "4.18.1",
    "lodash": "4.18.1",
    "nanoid": "3.3.18",
    "next": "16.3.4",
    "postcss": "8.5.26",
    "systeminformation": "5.33.7",
    "tmp": "0.2.7",
    "undici": "8.10.1",
    "kysely": "0.29.5",
    "nodemailer": "9.1.0",
    "ws": "8.21.3",
    "uuid": "11.1.1",
    "qs": "6.16.0",
    "@opentelemetry/core": "2.11.0",
    "js-yaml": "5.4.1",
    "@better-fetch/fetch": "1.3.1",
    "better-call": "1.4.0",
    "vite": "8.2.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "minimatch": "9.0.9",
    "fast-xml-parser": "5.11.1",
    "mermaid": "11.17.2",
    "engine.io": "6.6.9"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@prisma/client",
    "@prisma/engines",
    "@sentry/cli",
    "@swc/core",
    "core-js",
    "esbuild",
    "msgpackr-extract",
    "prisma",
    "protobufjs",
    "puppeteer",
    "sharp",
    "unrs-resolver",
    "vue-demi",
    "zenstack",
    "nexus-prisma"
  ],
  "patchedDependencies": {
    "tree-sitter-wasms@0.1.13": "patches/tree-sitter-wasms@0.1.13.patch"
  },
  "version": "4.0.9"
}
