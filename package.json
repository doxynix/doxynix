{
  "name": "doxynix",
  "version": "4.2.7",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "clean:symlinks": "bun scripts/clean-symlinks.ts",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "db:studio": "turbo db:studio",
    "dev": "turbo dev --filter=!@doxynix/cli",
    "dump:packages": "find . \\( -name \"node_modules\" -o -name \".next\" -o -name \".turbo\" \\) -prune -o -name \"package.json\" -print -exec bunx cli-highlight {} \\;",
    "dup": "jscpd",
    "format": "turbo format",
    "format:check": "biome check .",
    "postinstall": "bun scripts/clean-symlinks.ts",
    "knip": "SKIP_ENV_VALIDATION=development CI=true knip-bun --no-exit-code",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "nuke": "rm -rf node_modules/ apps/**/node_modules/ packages/**/node_modules bun.lock .turbo/ .next/ && bun pm cache rm && bun install --force",
    "secretlint": "secretlint '**/*'",
    "spellcheck": "cspell \"**/*\" --no-progress --show-suggestions",
    "test": "turbo test",
    "test:stryker": "turbo test:stryker",
    "type-check": "turbo type-check",
    "validate": "turbo validate && bun scripts/arch-check.ts"
  },
  "overrides": {
    "@better-fetch/fetch": "^1.1.21",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@hono/node-server": "2.1.1",
    "@opentelemetry/core": ">=2.8.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "better-call": "^1.3.5",
    "cookie": "^0.7.0",
    "cross-spawn": "7.0.6",
    "dompurify": "^3.4.0",
    "effect": "^3.20.0",
    "engine.io": "^6.6.7",
    "esbuild": "^0.28.0",
    "fast-xml-parser": "^5.10.1",
    "h3": "^1.15.9",
    "hono": "4.13.7",
    "js-yaml": ">=4.2.0",
    "kysely": ">=0.28.17",
    "lodash": "^4.17.24",
    "lodash-es": "^4.17.24",
    "mermaid": "11.17.2",
    "minimatch": "^9.0.7",
    "nanoid": "^3.3.16",
    "next": "^16.2.12",
    "nodemailer": ">=9.0.1",
    "postcss": "^8.5.3",
    "qs": ">=6.15.2",
    "systeminformation": "^5.30.8",
    "tmp": "0.2.7",
    "undici": "^8.9.0",
    "uuid": "^11.1.1",
    "vite": ">=8.0.16",
    "ws": ">=8.21.0"
