{
  "name": "doxynix",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=!@doxynix/cli",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "type-check": "turbo type-check",
    "validate": "turbo validate && bun scripts/arch-check.ts",
    "test": "turbo test",
    "test:stryker": "turbo test:stryker",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:migrate": "turbo db:migrate",
    "db:studio": "turbo db:studio",
    "secretlint": "secretlint '**/*'",
    "spellcheck": "cspell \"**/*\" --no-progress --show-suggestions",
    "dup": "jscpd",
    "knip": "SKIP_ENV_VALIDATION=development CI=true knip-bun --no-exit-code",
    "nuke": "rm -rf node_modules/ apps/**/node_modules/ packages/**/node_modules bun.lock .turbo/ .next/ && bun pm cache rm && bun install --force"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@types/node": "26.1.2",
    "cspell": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jscpd": "4.3.0",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "secretlint": "13.0.4",
    "turbo": "2.10.11",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@hono/node-server": "2.1.1",
    "cookie": "0.7.2",
    "cross-spawn": "7.0.6",
    "dompurify": "3.4.14",
    "effect": "3.22.1",
    "esbuild": "0.25.12",
    "h3": "1.15.11",
    "hono": "4.13.3",
    "lodash-es": "4.18.1",
    "lodash": "4.18.1",
    "nanoid": "3.3.18",
    "next": "16.3.2",
    "postcss": "8.5.26",
    "systeminformation": "5.33.1",
    "tmp": "0.2.7",
    "undici": "8.10.0",
    "kysely": "0.29.5",
    "nodemailer": "9.0.5",
    "ws": "8.21.3",
    "uuid": "11.1.1",
    "qs": "6.15.3",
    "@opentelemetry/core": "2.10.0",
    "js-yaml": "5.3.0",
    "@better-fetch/fetch": "1.3.1",
    "better-call": "1.4.0",
    "vite": "8.2.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "minimatch": "9.0.9",
    "fast-xml-parser": "5.11.0",
    "mermaid": "11.17.0",
    "engine.io": "6.6.9"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@prisma/client",
    "@prisma/engines",
    "@sentry/cli",
    "@swc/core",
    "core-js",
    "esbuild",
    "msgpackr-extract",
    "prisma",
    "protobufjs",
    "puppeteer",
    "sharp",
    "unrs-resolver",
    "vue-demi",
    "zenstack",
    "nexus-prisma"
  ],
  "version": "3.0.15"
}