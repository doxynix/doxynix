{
  "name": "doxynix",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=!@doxynix/cli",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "type-check": "turbo type-check",
    "validate": "turbo validate && bun scripts/arch-check.ts",
    "test": "turbo test",
    "test:stryker": "turbo test:stryker",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:migrate": "turbo db:migrate",
    "db:studio": "turbo db:studio",
    "secretlint": "secretlint '**/*'",
    "spellcheck": "cspell \"**/*\" --no-progress --show-suggestions",
    "dup": "jscpd",
    "knip": "SKIP_ENV_VALIDATION=development CI=true knip-bun --no-exit-code",
    "nuke": "rm -rf node_modules/ apps/**/node_modules/ packages/**/node_modules bun.lock .turbo/ .next/ && bun pm cache rm && bun install --force"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@types/node": "26.1.2",
    "cspell": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jscpd": "4.3.0",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "secretlint": "13.0.4",
    "turbo": "2.10.10",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "cookie": "^0.7.0",
    "cross-spawn": "7.0.6",
    "dompurify": "^3.4.0",
    "effect": "^3.20.0",
    "esbuild": "^0.25.0",
    "h3": "^1.15.9",
    "hono": "^4.12.34",
    "lodash-es": "^4.17.24",
    "lodash": "^4.17.24",
    "nanoid": "^3.3.16",
    "next": "^16.2.12",
    "postcss": "^8.5.3",
    "systeminformation": "^5.30.8",
    "tmp": "0.2.7",
    "undici": "^8.9.0",
    "kysely": ">=0.28.17",
    "nodemailer": ">=9.0.1",
    "ws": ">=8.21.0",
    "uuid": "^11.1.1",
    "qs": ">=6.15.2",
    "@opentelemetry/core": ">=2.8.0",
    "js-yaml": ">=4.2.0",
    "@better-fetch/fetch": "^1.1.21",
    "better-call": "^1.3.5",
    "vite": ">=8.0.16",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "minimatch": "^9.0.7",
    "fast-xml-parser": "^5.10.1",
    "mermaid": "^11.16.1",
    "engine.io": "^6.6.7"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@prisma/client",
    "@prisma/engines",
    "@sentry/cli",
    "@swc/core",
    "core-js",
    "esbuild",
    "msgpackr-extract",
    "prisma",
    "protobufjs",
    "puppeteer",
    "sharp",
    "unrs-resolver",
    "vue-demi",
    "zenstack",
    "nexus-prisma"
  ],
  "version": "3.0.9"
}