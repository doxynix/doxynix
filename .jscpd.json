{
  "mode": "strict",
  "threshold": 5,
  "reporters": [
    "console"
  ],
  "ignore": [
    "**/shared/api-contracts/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/build/**",
    "**/*.d.ts",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/routeTree.gen.ts",
    "**/prisma/migrations/**",
    "**/src/shared/ui/icons/**",
    "**/src/shared/ui/visuals/**",
    "**/src/shared/ui/core/**",
    "**/messages/*.json"
  ],
  "format": [
    "typescript",
    "tsx",
    "javascript"
  ],
  "pattern": "**/*.{ts,tsx,js,jsx}"
}