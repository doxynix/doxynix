{
  "format": ["typescript", "tsx", "javascript"],
  "ignore": [
    "**/shared/api-contracts/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/build/**",
    "**/*.d.ts",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/routeTree.gen.ts",
    "**/prisma/migrations/**",
    "**/src/shared/ui/icons/**",
    "**/src/shared/ui/visuals/**",
    "**/src/shared/ui/core/**",
    "**/messages/*.json"
  ],
  "mode": "strict",
  "pattern": "**/*.{ts,tsx,js,jsx}",
  "reporters": ["console"],
  "threshold": 5
}
