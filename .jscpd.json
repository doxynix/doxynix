{
  "format": ["typescript", "tsx", "javascript"],
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/build/**",
    "**/*.d.ts",
    "**/.dependency-cruiser.ts",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/prisma/migrations/**",
    "**/src/shared/ui/icons/**",
    "**/src/shared/ui/visuals/**",
    "**/src/shared/ui/core/**",
    "**/messages/*.json",
    "**/.agents/**",
    "**/.continue/**",
    "**/.claude/**",
    "**/.opencode/**"
  ],
  "minLines": 8,
  "minTokens": 60,
  "mode": "strict",
  "pattern": "**/*.{ts,tsx,js,jsx}",
  "reporters": ["console"],
  "threshold": 5
}
