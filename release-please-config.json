{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "package-name": "doxynix",
      "release-type": "node"
    },
    "apps/siem-client": {
      "bump-minor-pre-major": true,
      "bump-patch-pre-major": true,
      "package-name": "@doxynix/siem-client",
      "release-type": "node"
    },
    "apps/siem-server": {
      "bump-minor-pre-major": true,
      "bump-patch-pre-major": true,
      "package-name": "@doxynix/siem-server",
      "release-type": "node"
    },
    "apps/web": {
      "package-name": "@doxynix/web",
      "release-type": "node"
    },
    "packages/cli": {
      "package-name": "@doxynix/cli",
      "release-type": "node"
    },
    "packages/config": {
      "package-name": "@doxynix/config",
      "release-type": "node"
    },
    "packages/shared": {
      "package-name": "@doxynix/shared",
      "release-type": "node"
    }
  },
  "plugins": [
    {
      "type": "node-workspace"
    }
  ]
}
