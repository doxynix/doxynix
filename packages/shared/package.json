{
  "name": "@doxynix/shared",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "TZ=UTC vitest run --config vitest.config.ts",
    "test:coverage": "TZ=UTC vitest run --config vitest.config.ts --coverage",
    "type-check": "bun check -b",
    "validate": "biome check . && oxlint && bun type-check && bun run test"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@doxynix/config": "workspace:*",
    "vitest": "catalog:"
  }
}
