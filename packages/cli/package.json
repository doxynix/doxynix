{
  "name": "@doxynix/cli",
  "version": "2.1.5",
  "type": "module",
  "bin": {
    "dxnx": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:bin": "bun build src/index.ts --compile --minify --outfile dxnx",
    "dev": "bun src/index.ts",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "type-check": "tsc --noEmit",
    "validate": "biome check . && oxlint"
  },
  "dependencies": {
    "@clack/prompts": "1.8.0",
    "@trpc/client": "catalog:",
    "commander": "14.0.3",
    "picocolors": "1.1.1",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@doxynix/config": "workspace:*",
    "@doxynix/shared": "workspace:*",
    "@doxynix/web": "workspace:*",
    "@trpc/server": "catalog:",
    "tsup": "8.5.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
