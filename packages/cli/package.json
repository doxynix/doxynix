{
  "name": "@doxynix/cli",
  "version": "5.4.10",
  "description": "AI-powered repository analysis and documentation CLI.",
  "keywords": [
    "doxynix",
    "cli",
    "documentation",
    "code-analysis",
    "repository-analysis",
    "ai"
  ],
  "homepage": "https://doxynix.space",
  "bugs": {
    "url": "https://github.com/doxynix/doxynix/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doxynix/doxynix.git",
    "directory": "packages/cli"
  },
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Doxynix",
    "url": "https://doxynix.space"
  },
  "type": "module",
  "bin": {
    "doxynix": "./dist/index.js",
    "dxnx": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "arch:baseline": "depcruise src --config .dependency-cruiser.ts --baseline",
    "arch:check": "depcruise src --config .dependency-cruiser.ts --output-type err --ignore-known",
    "prebuild": "rm -rf dist",
    "build": "bun build src/index.ts --target=node --format=esm --outdir=dist --minify --keep-names --banner '#!/usr/bin/env node'",
    "build:bin": "bun build src/index.ts --compile --minify --bytecode --format=esm --outfile dxnx",
    "dev": "bun src/index.ts",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "TZ=UTC vitest run --config vitest.config.ts",
    "test:coverage": "TZ=UTC vitest run --coverage --config vitest.config.ts",
    "type-check": "bun check",
    "validate": "biome check . && oxlint && bun run arch:check && bun type-check"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@doxynix/config": "workspace:*",
    "@doxynix/shared": "workspace:*",
    "@doxynix/web": "workspace:*",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@vitest/coverage-v8": "5.0.5",
    "commander": "14.0.3",
    "dependency-cruiser": "18.7.0",
    "ora": "9.4.1",
    "pathe": "catalog:",
    "picocolors": "1.1.1",
    "superjson": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
