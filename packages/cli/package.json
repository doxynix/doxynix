{
  "name": "@doxynix/cli",
  "version": "5.4.5",
  "type": "module",
  "bin": {
    "doxynix": "./dist/index.js",
    "dxnx": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "arch:baseline": "depcruise src --config .dependency-cruiser.ts --baseline",
    "arch:check": "depcruise src --config .dependency-cruiser.ts --output-type err --ignore-known",
    "build": "tsup",
    "build:bin": "bun build src/index.ts --compile --minify --outfile dxnx",
    "dev": "bun src/index.ts",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "TZ=UTC vitest run --config vitest.config.ts",
    "test:coverage": "TZ=UTC vitest run --coverage --config vitest.config.ts",
    "type-check": "bun check",
    "validate": "biome check . && oxlint && bun run arch:check && bun type-check"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@trpc/client": "catalog:",
    "commander": "14.0.3",
    "ora": "9.4.1",
    "pathe": "catalog:",
    "picocolors": "1.1.1",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@doxynix/config": "workspace:*",
    "@doxynix/shared": "workspace:*",
    "@doxynix/web": "workspace:*",
    "@trpc/server": "catalog:",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.6.0",
    "tsup": "9.0.0",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
