{
  "bin": {
    "dxnx": "./dist/index.js"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@doxynix/shared": "workspace:*",
    "@trpc/client": "11.18.0",
    "cli-table3": "0.6.5",
    "commander": "14.0.3",
    "picocolors": "1.1.1",
    "superjson": "2.2.6"
  },
  "devDependencies": {
    "@doxynix/config": "workspace:*",
    "@doxynix/web": "workspace:*",
    "@trpc/server": "11.18.0",
    "tsup": "8.5.1"
  },
  "name": "@doxynix/cli",
  "scripts": {
    "build": "tsup",
    "build:bin": "bun build src/index.ts --compile --minify --outfile dxnx",
    "dev": "bun src/index.ts",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "type-check": "tsc --noEmit",
    "validate": "biome check . && oxlint"
  },
  "type": "module",
  "version": "2.1.0"
}
