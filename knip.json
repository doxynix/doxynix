{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".agents/**", ".opencode/**"],
  "ignoreBinaries": ["dot", "doppler", "podman", "semgrep", "with-doppler"],
  "ignoreDependencies": [
    "@secretlint/secretlint-rule-preset-recommend",
    "decimal.js",
    "k6",
    "prisma-generator-fake-data",
    "tree-sitter-wasm"
  ],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    "apps/siem-server": {
      "entry": ["scripts/*.ts"]
    },
    "apps/web": {
      "entry": [
        "src/app/**/page.tsx",
        "src/app/api/**/route.ts",
        "src/server/**/tasks/*.task.ts",
        "src/server/**/tasks/{init,handle-task-error}.ts",
        "scripts/**/*.{ts,mjs,js}",
        "prisma/seed.ts",
        "sentry.*.config.ts",
        "steiger.config.mjs",
        "trigger.config.ts",
        "vitest.*.config.ts"
      ],
      "ignore": [".eloqnt/config.ts", "prisma/schema.prisma", "src/shared/i18n/request.ts"]
    }
  }
}
