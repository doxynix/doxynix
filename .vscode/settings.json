{
  "[css]": { "editor.defaultFormatter": "biomejs.biome" },
  "[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[javascriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
  "[json]": { "editor.defaultFormatter": "biomejs.biome" },
  "[jsonc]": { "editor.defaultFormatter": "biomejs.biome" },
  "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },

  "conventionalCommits.scopes": [
    "web",
    "siem-server",
    "siem-client",
    "cli",
    "shared",
    "config",
    "root"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },

  "files.exclude": {
    "**/.bun": true,
    "**/.git": true,
    "**/.next": true,
    "**/.stryker-tmp": true,
    "**/.trigger": true,
    "**/.turbo": true,
    "**/coverage": true,
    "**/dist": true,
    "**/playwright-report": true,
    "**/prisma/generated": true,
    "**/test-results": true
  },

  "files.watcherExclude": {
    "**/.bun/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.next/**": true,
    "**/.stryker-tmp/**": true,
    "**/.trigger/**": true,
    "**/.turbo/**": true,
    "**/coverage/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/playwright-report/**": true,
    "**/prisma/generated/**": true,
    "**/test-results/**": true
  },
  "js/ts.experimental.useTsgo": true,
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.suggest.completeFunctionCalls": true,
  "js/ts.tsdk.path": "./node_modules/typescript",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.tsserver.maxMemory": 8192,

  "oxc.configPath": ".oxlintrc.json",
  "oxc.enable": true,

  "prisma.pinToPrisma6": true,

  "search.exclude": {
    "**/.bun": true,
    "**/.next": true,
    "**/.trigger": true,
    "**/.turbo": true,
    "**/coverage": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/prisma/generated": true,
    "**/routeTree.gen.ts": true
  },

  "sonarlint.connectedMode.project": {
    "connectionId": "doxynix",
    "projectKey": "doxynix_doxynix"
  },

  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "ngClass",
    "containerClassName",
    "contentClassName"
  ],
  "tailwindCSS.experimental.classRegex": [
    ["(?:cva|cn|clsx|cx)\\(([^)]*)\\)", "[\"'`]([^\"'`]+)[\"'`]"]
  ],
  "tailwindCSS.experimental.configFile": {
    "apps/siem-client": "apps/siem-client/src/global.css",
    "apps/web": "apps/web/src/app/globals.css"
  },

  "workbench.editor.labelFormat": "short"
}
